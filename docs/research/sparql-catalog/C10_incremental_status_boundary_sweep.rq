PREFIX jolux: <http://data.legilux.public.lu/resource/ontology/jolux#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Status sweep: acts whose in-force window boundary was crossed since the last sync (status flips do NOT bump graph dct:modified)
SELECT DISTINCT ?act ?status ?dateEntryInForce ?dateNoLongerInForce WHERE {
  ?act a jolux:Act ; jolux:inForceStatus ?status .
  OPTIONAL { ?act jolux:dateEntryInForce ?dateEntryInForce }
  OPTIONAL { ?act jolux:dateNoLongerInForce ?dateNoLongerInForce }
  FILTER( (BOUND(?dateNoLongerInForce) && ?dateNoLongerInForce >= "2026-09-01"^^xsd:date && ?dateNoLongerInForce <= "2026-10-16"^^xsd:date)
       || (BOUND(?dateEntryInForce) && ?dateEntryInForce >= "2026-09-01"^^xsd:date && ?dateEntryInForce <= "2026-10-16"^^xsd:date) )
  FILTER(STRSTARTS(STR(?act), "http://data.legilux.public.lu/eli/etat/leg/"))
}
