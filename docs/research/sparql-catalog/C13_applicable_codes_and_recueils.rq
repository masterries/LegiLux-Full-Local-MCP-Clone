PREFIX jolux: <http://data.legilux.public.lu/resource/ontology/jolux#>
SELECT DISTINCT ?c ?type ?d ?title WHERE {
  ?c a jolux:Consolidation ; jolux:inForceStatus <http://data.legilux.public.lu/resource/authority/application-status/applicable> ; jolux:typeDocument ?type ; jolux:dateApplicability ?d .
  FILTER(?type IN (<http://data.legilux.public.lu/resource/authority/resource-type/RECUEIL>, <http://data.legilux.public.lu/resource/authority/resource-type/CODE_RECUEIL>, <http://data.legilux.public.lu/resource/authority/resource-type/CODE>))
  OPTIONAL { ?c jolux:isRealizedBy/jolux:title ?title }
} ORDER BY ?type ?c
