# Q08 — Mémorial references (GR histid) [V, DISTINCT added]: 71,455 rows, 10 MB. Cadence: weekly.
# ?mem such as …/eli/etat/leg/memorial/1997/a36 renders as « Mémorial A n° 36 de 1997 ».
SELECT DISTINCT ?a ?h ?mem WHERE { ?a a jolux:Act ; jolux:historicalLegalId ?h . OPTIONAL { ?a jolux:isPartOf ?mem }
  FILTER(CONTAINS(STR(?a),"/eli/etat/leg/")) }
