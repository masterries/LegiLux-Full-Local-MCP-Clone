# Copy to .env (gitignored) and adjust. Read by lgx_core.config.Settings (LGX_*) and the Makefile.
# Never put API keys here: secrets live in 0600 files / Docker secrets (PLAN §3.7, §10.2).

# --- build pipeline ---
LGX_DATA_DIR=./data
LGX_CONFIG_DIR=./config
LGX_SPARQL_URL=https://data.legilux.public.lu/sparqlendpoint
LGX_FILESTORE_BASE=https://legilux.public.lu/filestore/
LGX_USER_AGENT="LegiLux-Local-Clone/0.1 (+https://github.com/masterries/LegiLux-Full-Local-MCP-Clone)"
# >= 1.0: never more than 1 request per second
LGX_RATE_LIMIT_S=1.2
LGX_HTTP_TIMEOUT_S=60

# --- throwaway dev database (make db-up / db-schema; container lgx-db-dev, removed by make db-down) ---
LGX_DB_IMAGE=lgx.local/lgx-db:dev
LGX_DB_CONTAINER=lgx-db-dev
LGX_DB_PORT=55432
LGX_DB_NAME=legilux_dev
# dev containers only; generated secrets in deploy
POSTGRES_PASSWORD=lgx-dev-only

# --- persistent dev database (container lgx-dev-db, volume lgx-dev-pgdata, 127.0.0.1:55432; docs/dev/INTERFACES.md §6.1) ---
# Build/owner role used by `lgx load|gates|report|package|ingest` (the loader connects to this DSN's database,
# here `postgres`, and creates legilux_build_<T>[_sample]; `--restore-to legilux` builds the runtime database).
LGX_PG_DSN=postgresql://postgres:lgx-dev-only@127.0.0.1:55432/postgres
# Read-only role for the MCP server (dev password, set once: ALTER ROLE lgx_ro PASSWORD 'lgx-ro-dev-only').
# Compose-style names (Appendix C) for the same connection; in the airgap the password comes from the pg_ro_pw secret.
LGX_MCP_PG_DSN=postgresql://lgx_ro:lgx-ro-dev-only@127.0.0.1:55432/legilux
# LGX_DB_HOST=127.0.0.1  LGX_DB_PORT=55432  LGX_DB_NAME=legilux  LGX_DB_USER=lgx_ro  LGX_DB_PASSWORD=lgx-ro-dev-only

# --- embeddings: OFF by default (provider none; config/embedding.yaml, every key overridable by LGX_EMBED_*) ---
LGX_EMBED_PROVIDER=none
# LGX_EMBED_BASE_URL=https://api.mistral.ai              # Mistral SaaS here; the on-prem domain in the airgap
# LGX_EMBED_API_KEY_FILE=./secrets/mistral_api_key       # 0600 file, never committed, never in a bundle
# LGX_EMBED_MAX_CONCURRENCY=5                            # throttle: requests in flight
# LGX_EMBED_COOLDOWN_S=20                                # throttle: per-slot wait after each request

# --- tests ---
# LGX_RUN_LIVE=1                 # enable @pytest.mark.live tests (polite, few requests)
# LGX_TEST_PG_DSN=postgresql://postgres:postgres@localhost:5432/postgres   # use a server instead of Docker
