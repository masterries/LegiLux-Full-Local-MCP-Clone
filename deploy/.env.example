# deploy/.env — read by `docker compose` from deploy/ (copy this file; deploy/.env is gitignored).
# In the airgap `lgx install` writes deploy/.env; on the connected dev host `lgx dev-init` will (M1). Until then
# every variable below has a working dev default in compose.dev.yml: nothing here is required to start.
# Never put real API keys here: they belong in 0600 files (secrets/ at the repo root, gitignored).

# ------------------------------------------------------------------ dev stack (compose.dev.yml)
# Host ports (always bound to 127.0.0.1)
# LGX_DEV_UI_PORT=8501
# LGX_DEV_MCP_PORT=8000

# Dev credentials, passed as the plain dev variables LGX_DB_PASSWORD / LGX_MCP_TOKEN (compose.dev.yml header; the
# airgap uses LGX_*_FILE Docker secrets readable by uid 10001, see compose.yml). API keys are files only (below).
# LGX_DEV_PG_PASSWORD=lgx-dev-only          # superuser; only used when the data volume is initialised
# LGX_DEV_RO_PASSWORD=lgx-ro-dev-only       # lgx_ro (MCP server); db-load sets it on every start
# LGX_DEV_MCP_TOKEN=lgx-dev-mcp-token       # bearer token shared by mcp and lgx-streamlit

# Database volume and the bundle db-load restores into it (once, when the `legilux` database is missing)
# LGX_DEV_PGDATA_VOLUME=legilux-dev-pgdata  # set to lgx-dev-pgdata ONLY after `docker stop lgx-dev-db`
# LGX_DEV_DB_FORCE=0                        # 1 = ignore a stale postmaster.pid on a shared volume (after a crash)
# LGX_DEV_BUNDLES_DIR=../data/bundles
# LGX_DEV_BUNDLE=data-2026-10-16-sample.dump

# MCP server
# LGX_RERANK=off                            # off until the TEI reranker service exists (M2)
# LGX_MAX_RESULT_TOKENS=2500
# LGX_DEV_MCP_URL=http://mcp:8000/mcp       # e.g. http://host.docker.internal:8000/mcp for a host-run server

# Chat LLM of the tester UI: ONE external OpenAI-compatible endpoint (no LLM runtime is bundled). Default: the user's
# Mistral endpoint — Mistral SaaS on this host, the same API under the on-prem domain in the airgap.
# LGX_LLM_BASE_URL=https://api.mistral.ai/v1
# LGX_LLM_MODEL=mistral-small-latest       # [U] the model the endpoint serves
# LGX_LLM_KEY_FILE=../secrets/llm_api_key  # 0600 file, never committed, never in a bundle (default /dev/null = no key)
# LGX_LLM_TRUST_ENV=0                       # 1 + LGX_LLM_HTTPS_PROXY: reach the endpoint through an HTTPS proxy
# LGX_LLM_HTTPS_PROXY=
# LGX_LLM_TIMEOUT_S=120
# LGX_TURN_BUDGET_S=600
# LGX_TOOL_RESULT_TOKENS=2500

# Embeddings: OFF (user decision). provider mistral = Mistral embeddings API (same on both sides, only the URL differs)
# LGX_EMBED_PROVIDER=none                   # none | mistral
# LGX_EMBED_BASE_URL=https://api.mistral.ai
# LGX_EMBED_KEY_FILE=../secrets/mistral_api_key   # 0600 file (default /dev/null = no key)
# LGX_EMBED_MAX_CONCURRENCY=5               # throttle: requests in flight
# LGX_EMBED_COOLDOWN_S=20                   # throttle: each slot waits this long after its request

# ------------------------------------------------------------------ airgap runtime (compose.yml)
# LGX_HOME=/opt/legilux
# LGX_PLATFORM=2026.10.0
# LGX_HOSTNAME=legilux.intra
# LGX_BIND_ADDR=10.20.0.15
# LGX_RERANK_K=16                           # small CPU host
# LGX_LLM_BASE_URL=https://mistral.example.intra/v1   # the user's on-prem Mistral endpoint (chat)
# LGX_LLM_MODEL=
# LGX_EMBED_PROVIDER=none                   # mistral once the release carries vectors (startup probe decides)
# LGX_EMBED_BASE_URL=https://mistral.example.intra    # same domain, no /v1
# LGX_MISTRAL_HOST=mistral.example.intra    # resolved via extra_hosts (no upstream DNS in the airgap)
# LGX_MISTRAL_IP=10.20.0.40                 # the only destination DOCKER-USER admits from br-lgx-encl
# LGX_TRUSTED_PROXIES=172.30.0.20/32        # Open WebUI (fixed backend IP): only its x-openwebui-user-* headers count
# LGX_TESTUI_USER=tester
# LGX_TESTUI_BCRYPT='$2a$14$...'            # single-quoted (bcrypt contains $); required once the proxy is added
